<?xml version="1.0" encoding="utf-8"?>
<!-- Los perfiles Wi-Fi contienen claves: nunca salen del dispositivo. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
